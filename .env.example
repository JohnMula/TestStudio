# Server-only Supabase configuration. Never expose the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase configuration for OAuth/session UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required in production. Use a long, random secret distinct from every other key.
RATE_LIMIT_SECRET=

# Required in production to protect public test submission.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Required in production. Comma-separated hostnames accepted by Turnstile, for example:
# TURNSTILE_HOSTNAMES=app.example.com,www.example.com
TURNSTILE_HOSTNAMES=

# Leave unset on Vercel. Set only when a trusted reverse proxy overwrites
# inbound X-Forwarded-For/X-Real-IP headers before requests reach this app.
# TRUST_PROXY_IP_HEADERS=true
